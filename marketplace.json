{
  "schemaVersion": "0.1",
  "source": "local-seed",
  "futureSource": "https://github.com/example/NDK-Marketplace",
  "plugins": [
    {
      "id": "ytdlp",
      "name": "NDK-yt-dlp",
      "version": "0.1.0",
      "description": "ytdlp plugin",
      "type": "Multimedia",
      "github": "https://github.com/example/NDK-ytdlp",
      "enabledByDefault": true,
      "installer": {
        "windows": {
          "workDir": "plugins/workspace/ytdlp",
          "toolsDir": "plugins/installed/ytdlp/vendor/bin",
          "tools": [
            {
              "id": "yt-dlp",
              "name": "yt-dlp",
              "url": "https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp.exe",
              "target": "yt-dlp.exe"
            }
          ]
        },
        "linux": {
          "workDir": "plugins/workspace/ytdlp",
          "toolsDir": "plugins/installed/ytdlp/vendor/bin",
          "tools": [
            {
              "id": "yt-dlp",
              "name": "yt-dlp",
              "url": "https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp_linux",
              "target": "yt-dlp"
            }
          ]
        }
      },
      "entryPoints": {},
      "main": {
        "entry": "main/index.mjs"
      }
    },
    {
      "id": "youtube-player",
      "name": "NDK-YouTube Player",
      "version": "0.1.0",
      "description": "Online multimedia player",
      "type": "Multimedia",
      "github": "https://github.com/example/NDK-YouTube-Player",
      "enabledByDefault": true,
      "entryPoints": {
        "home": {
          "label": "YouTube",
          "route": "/plugins/youtube-player",
          "order": 100
        },
        "settings": {
          "route": "/settings/plugins/youtube-player"
        }
      },
      "renderer": {
        "source": "renderer/YouTubePluginPage.jsx",
        "entry": "renderer/index.js"
      },
      "main": {
        "entry": "main/index.mjs"
      }
    }
  ]
}
